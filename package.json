{
  "name": "failure-packager",
  "version": "0.1.0",
  "description": "Package failing test output into clean reports for humans and AI coding agents.",
  "type": "module",
  "license": "MIT",
  "author": "Michael Ko",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/michaelko/failure-packager.git"
  },
  "homepage": "https://github.com/michaelko/failure-packager#readme",
  "bugs": {
    "url": "https://github.com/michaelko/failure-packager/issues"
  },
  "keywords": [
    "cli",
    "testing",
    "failures",
    "reports",
    "agents",
    "ci"
  ],
  "bin": {
    "failure-packager": "./dist/index.js",
    "failpack": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node ./scripts/chmod-bin.mjs",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14"
  }
}
